{
  "$schema": "https://smithery.ai/schema/server.json",
  "name": "multi-carrier-tracking-mcp",
  "displayName": "Package Tracking (8 carriers)",
  "description": "Auto-detects USPS, UPS, FedEx, DHL, India Post, Delhivery, BlueDart, Aramex from a tracking number. Returns structured events and current status.",
  "version": "0.3.0",
  "license": "MIT",
  "homepage": "https://multi-carrier-tracking-mcp.workers.dev",
  "repository": "https://github.com/guptaprakhariitr/multi-carrier-tracking-mcp",
  "categories": ["logistics", "ecommerce", "utility"],
  "tags": ["tracking", "usps", "ups", "fedex", "dhl", "india-post", "delhivery", "shipping"],
  "transport": { "type": "http", "url": "https://multi-carrier-tracking-mcp.workers.dev/mcp" },
  "auth": {
    "type": "bearer",
    "tokenUrl": "https://multi-carrier-tracking-mcp.workers.dev/account/keys",
    "freeTier": { "monthlyCalls": 100, "ratePerMinute": 10 }
  },
  "tools": ["track_package", "track_multiple", "detect_carrier", "list_carriers", "subscribe_tracking"],
  "pricing": {
    "currency": "USD",
    "tiers": [
      { "name": "Free", "price": 0,  "monthlyCalls": 100 },
      { "name": "Solo", "price": 9,  "monthlyCalls": 2000 },
      { "name": "Team", "price": 29, "monthlyCalls": 10000 },
      { "name": "Pro",  "price": 79, "monthlyCalls": 50000 }
    ]
  },
  "support": { "issues": "https://github.com/guptaprakhariitr/multi-carrier-tracking-mcp/issues" }
}
